{
  "entities": {
    "Report": {
      "title": "CommissioningReport",
      "description": "Pre-commissioning test report for EV Charger and Battery Swap Stations (BSS)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the commissioning report",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Display title or station code of the report",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the report was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when the report was last updated"
        },
        "tenantId": {
          "type": "string",
          "description": "ID of the rental contractor tenant who created the report",
          "maxLength": 128
        },
        "creatorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the creator user",
          "maxLength": 128
        },
        "creatorEmail": {
          "type": "string",
          "description": "Email of the creator user",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "description": "Workflow status of the report",
          "enum": ["draft", "submitted", "approved", "completed"]
        },
        "generalInfo": {
          "type": "object",
          "description": "General plant metadata, charger SN, billing ID, coordinates, and vendor details"
        },
        "fieldTesting": {
          "type": "object",
          "description": "Extended 3-phase voltage, RCCB/ELCB trip time, Megger insulation, thermal, calibration, and K3 safety checks"
        },
        "approval": {
          "type": "object",
          "description": "Signatures and verification stamps"
        }
      },
      "required": ["id", "title", "createdAt", "updatedAt"]
    },
    "ReportPhoto": {
      "title": "ReportPhoto",
      "description": "Individual photo proof and measurement item associated with a report",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Photo item identifier",
          "maxLength": 128
        },
        "reportId": {
          "type": "string",
          "description": "Parent report ID",
          "maxLength": 128
        },
        "sectionKey": {
          "type": "string",
          "description": "Report section identifier",
          "maxLength": 64
        },
        "photoKey": {
          "type": "string",
          "description": "Key within section",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "description": "Human readable item title",
          "maxLength": 256
        },
        "imageData": {
          "type": "string",
          "description": "Base64 data or image URL"
        },
        "measurementValue": {
          "type": "string",
          "description": "Multimeter or tester measured value",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "description": "Camera capture timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "reportId", "sectionKey", "photoKey"]
    },
    "Tenant": {
      "title": "RentalTenant",
      "description": "Contractor tenant profile and subscription package details (plaintext passwords forbidden)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Tenant unique identifier",
          "maxLength": 128
        },
        "companyName": {
          "type": "string",
          "description": "Registered company name",
          "maxLength": 256
        },
        "shortCode": {
          "type": "string",
          "description": "Tenant short code",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "description": "Registered tenant email address",
          "maxLength": 256
        },
        "passwordHash": {
          "type": "string",
          "description": "Salted SHA-256 hex digest of customer password",
          "maxLength": 128
        },
        "passwordSalt": {
          "type": "string",
          "description": "Per-tenant random hex salt",
          "maxLength": 64
        },
        "passwordUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp when password hash was last updated",
          "maxLength": 64
        },
        "picName": {
          "type": "string",
          "description": "Person in charge name",
          "maxLength": 128
        },
        "phone": {
          "type": "string",
          "description": "PIC WhatsApp phone",
          "maxLength": 32
        },
        "tier": {
          "type": "string",
          "description": "Subscription tier",
          "enum": ["trial", "starter", "pro", "enterprise", "custom"]
        },
        "status": {
          "type": "string",
          "description": "Rental status",
          "enum": ["active", "trial", "suspended", "expired"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment state",
          "enum": ["paid", "pending", "overdue"]
        },
        "reportsQuota": {
          "type": "number",
          "description": "Monthly report limit or -1 for unlimited"
        },
        "reportsUsed": {
          "type": "number",
          "description": "Non-refundable consumed report tokens"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "companyName", "email", "tier", "status"]
    },
    "SellerSettings": {
      "title": "SellerSettings",
      "description": "Platform seller WhatsApp number, bank accounts, and QRIS payment configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings identifier (default)",
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "description": "Seller business display name",
          "maxLength": 128
        },
        "adminWhatsapp": {
          "type": "string",
          "description": "Official seller WhatsApp number in 628... format",
          "maxLength": 32
        },
        "bankPrimaryName": {
          "type": "string",
          "description": "Primary bank name",
          "maxLength": 64
        },
        "bankPrimaryAccount": {
          "type": "string",
          "description": "Primary bank account number",
          "maxLength": 64
        },
        "bankPrimaryHolder": {
          "type": "string",
          "description": "Primary bank account holder name",
          "maxLength": 128
        },
        "bankSecondaryName": {
          "type": "string",
          "description": "Secondary bank name",
          "maxLength": 64
        },
        "bankSecondaryAccount": {
          "type": "string",
          "description": "Secondary bank account number",
          "maxLength": 64
        },
        "bankSecondaryHolder": {
          "type": "string",
          "description": "Secondary bank account holder name",
          "maxLength": 128
        },
        "qrisImage": {
          "type": "string",
          "description": "Compressed QRIS image data URL",
          "maxLength": 500000
        },
        "paymentNotes": {
          "type": "string",
          "description": "Payment instructions shown to customers",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "businessName", "adminWhatsapp"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Customer upgrade, renewal, or activation payment proof submission",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique payment request ID",
          "maxLength": 128
        },
        "tenantId": {
          "type": "string",
          "description": "Associated rental tenant ID",
          "maxLength": 128
        },
        "companyName": {
          "type": "string",
          "description": "Customer company name",
          "maxLength": 256
        },
        "shortCode": {
          "type": "string",
          "description": "Tenant short code",
          "maxLength": 16
        },
        "picName": {
          "type": "string",
          "description": "Customer PIC name",
          "maxLength": 128
        },
        "phone": {
          "type": "string",
          "description": "Customer WhatsApp number",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "description": "Customer email",
          "maxLength": 256
        },
        "requestType": {
          "type": "string",
          "description": "Type of billing request",
          "enum": ["upgrade", "renewal", "activation"]
        },
        "currentTier": {
          "type": "string",
          "description": "Current tier before payment",
          "enum": ["trial", "starter", "pro", "enterprise", "custom"]
        },
        "requestedTier": {
          "type": "string",
          "description": "Requested target tier",
          "enum": ["trial", "starter", "pro", "enterprise", "custom"]
        },
        "requestedTierName": {
          "type": "string",
          "description": "Display name of requested tier",
          "maxLength": 128
        },
        "durationMonths": {
          "type": "number",
          "description": "Subscription duration in months"
        },
        "amount": {
          "type": "number",
          "description": "Total IDR transfer amount"
        },
        "senderBankOrName": {
          "type": "string",
          "description": "Sender account holder or bank",
          "maxLength": 128
        },
        "proofImage": {
          "type": "string",
          "description": "Compressed transfer receipt image data URL",
          "maxLength": 550000
        },
        "notes": {
          "type": "string",
          "description": "Customer notes",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Approval status",
          "enum": ["pending", "approved", "rejected"]
        },
        "rejectionReason": {
          "type": "string",
          "description": "Admin rejection note if rejected",
          "maxLength": 300
        },
        "processedAt": {
          "type": "string",
          "description": "Approval/rejection timestamp"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "tenantId", "requestedTier", "durationMonths", "amount", "status"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Append-only security and database audit trail event",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier",
          "maxLength": 128
        },
        "eventType": {
          "type": "string",
          "description": "Categorized security event type",
          "enum": [
            "login_success",
            "login_failed",
            "rate_limit_blocked",
            "password_updated",
            "password_migration",
            "tenant_created",
            "tenant_deleted",
            "payment_approved",
            "payment_rejected",
            "settings_updated",
            "report_deleted"
          ]
        },
        "severity": {
          "type": "string",
          "description": "Audit severity level",
          "enum": ["info", "warning", "critical"]
        },
        "actorEmail": {
          "type": "string",
          "description": "Email or identifier of actor",
          "maxLength": 256
        },
        "actorRole": {
          "type": "string",
          "description": "Role context of actor",
          "enum": ["owner", "tenant", "system", "anonymous"]
        },
        "targetId": {
          "type": "string",
          "description": "Target tenant, report, or settings document ID",
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "description": "Human-readable audit description",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when event occurred",
          "maxLength": 64
        }
      },
      "required": ["id", "eventType", "severity", "actorEmail", "actorRole", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/Report"
      },
      "description": "Stores commissioning test report documents and inspection metadata"
    },
    "/reports/{reportId}/photos/{photoId}": {
      "schema": {
        "$ref": "#/entities/ReportPhoto"
      },
      "description": "Stores individual visual inspection photos and multimeter readings per report"
    },
    "/tenants/{tenantId}": {
      "schema": {
        "$ref": "#/entities/Tenant"
      },
      "description": "Stores rental contractor tenant accounts, salted SHA-256 credentials, quotas, and subscription statuses"
    },
    "/sellerSettings/{settingId}": {
      "schema": {
        "$ref": "#/entities/SellerSettings"
      },
      "description": "Stores official seller WhatsApp contact, bank accounts, and QRIS details"
    },
    "/paymentRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/PaymentRequest"
      },
      "description": "Stores customer upgrade/renewal transfer proof submissions and admin approvals"
    },
    "/securityLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/SecurityLog"
      },
      "description": "Append-only security and database audit trail events"
    }
  }
}
